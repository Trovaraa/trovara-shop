# Copy to .env for local Vite (optional). Production values live in .env.deploy.

# Telegram customer order bot username (no @).
# VITE_TELEGRAM_CUSTOMER_BOT=

# Farm site for waitlist / product photos.
# VITE_PUBLIC_MARKETING_URL=https://trovara.farm

# Leave unset in local/prod: Accounts uses same-origin /shop (Vite/nginx → OS API).
# VITE_SHOP_API_URL=http://127.0.0.1:3000/shop
