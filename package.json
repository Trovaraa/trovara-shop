{
  "name": "trovara-shop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/security-headers.test.mjs scripts/dependency-security.test.mjs",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "glob": "13.0.6",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.10"
  },
  "overrides": {
    "glob": "$glob",
    "happy-dom": "$happy-dom"
  }
}
